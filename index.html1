/* ============================================================
   Утилиты
   ============================================================ */
const $ = (sel, root = document) => root.querySelector(sel);
const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));

const form = $('#quiz');
const formView = $('#form-view');
const resultView = $('#result-view');
const reference = $('#reference');
const progressBar = $('#progress-bar');

function getChecked(name) {
  return $$(`input[name="${name}"]:checked`, form).map(el => el.value);
}

function getRadio(name) {
  const el = $(`input[name="${name}"]:checked`, form);
  return el ? el.value : '';
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
}

/* ============================================================
   Презентация: подстановка ссылок
   ============================================================ */
function setupPresentationLinks() {
  const url = SITE_CONFIG.presentationUrl || '#';
  const links = ['top-presentation-link', 'footer-presentation-link'];
  links.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.href = url;
      el.title = SITE_CONFIG.presentationTitle;
      if (url === '#') el.classList.add('hidden');
    }
  });
}

/* ============================================================
   Прогресс + localStorage
   ============================================================ */
function updateProgress() {
  const groups = ['age', 'pregnancy', 'allergy', 'complaint', 'flag'];
  let done = 0;
  groups.forEach(g => {
    if ($(`input[name="${g}"]:checked`, form)) done++;
  });
  progressBar.style.width = Math.round(done / groups.length * 100) + '%';
}

function collectAnswers() {
  return {
    age: getRadio('age'),
    pregnancy: getRadio('pregnancy'),
    allergy: getRadio('allergy'),
    complaints: getChecked('complaint'),
    flags: getChecked('flag'),
    savedAt: new Date().toISOString()
  };
}

function saveAnswers() {
  try { localStorage.setItem(STORAGE_KEYS.answers, JSON.stringify(collectAnswers())); }
  catch (e) { /* приватный режим */ }
}

function restoreAnswers() {
  let saved;
  try { saved = JSON.parse(localStorage.getItem(STORAGE_KEYS.answers) || 'null'); }
  catch (e) { return; }
  if (!saved) return;

  const setRadio = (name, value) => {
    if (!value) return;
    const el = form.querySelector(`input[name="${name}"][value="${CSS.escape(value)}"]`);
    if (el) el.checked = true;
  };
  const setCheckboxes = (name, values) => {
    (values || []).forEach(v => {
      const el = form.querySelector(`input[name="${name}"][value="${CSS.escape(v)}"]`);
      if (el) el.checked = true;
    });
  };
  setRadio('age', saved.age);
  setRadio('pregnancy', saved.pregnancy);
  setRadio('allergy', saved.allergy);
  setCheckboxes('complaint', saved.complaints);
  setCheckboxes('flag', saved.flags);
  updateProgress();
}

function saveResult(answers) {
  try { localStorage.setItem(STORAGE_KEYS.result, JSON.stringify(answers)); }
  catch (e) {}
}

function restoreResultIfAny() {
23:57
try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEYS.result) || 'null');
    if (saved && saved.complaints && saved.complaints.length) renderResult(saved, { fromRestore: true });
  } catch (e) {}
}

/* ============================================================
   Рендер результата
   ============================================================ */
function renderSources(keys) {
  if (!keys || !keys.length) return '';
  const items = keys
    .map(k => REFERENCES[k])
    .filter(Boolean)
    .map(r => `<a href="${r.url}" target="_blank" rel="noopener">${escapeHtml(r.short)}</a>`)
    .join(', ');
  return `<div class="sources"><strong>Источники:</strong> ${items}</div>`;
}

function renderSlidesLink(slides) {
  if (!slides || !SITE_CONFIG.presentationUrl || SITE_CONFIG.presentationUrl === '#') return '';
  return `<a class="slides-link" href="${SITE_CONFIG.presentationUrl}" target="_blank" rel="noopener">
    📊  Подробнее в презентации: слайды ${escapeHtml(slides)}
  </a>`;
}

function renderFlags(answers) {
  const parts = [];
  if (answers.flags && answers.flags.length > 0) {
    parts.push(`
      <div class="card flag-danger">
        <h2>Сначала — к врачу</h2>
        <p>Вы отметили признаки, при которых подбор добавок и процедур «по анкете» недопустим. Это не значит, что всё плохо — это значит, что нужна диагностика.</p>
        <p>Обратитесь к терапевту или профильному специалисту. Обсудите с ним любые добавки, кремы и процедуры.</p>
      </div>`);
  }
  if (answers.age === '<18') {
    parts.push(`<div class="card flag-warn"><h2>Возраст до 18</h2><p>Для детей и подростков любые добавки и процедуры — только по назначению врача. Рацион и сон важнее.</p></div>`);
  }
  if (answers.pregnancy === 'yes') {
    parts.push(`<div class="card flag-warn"><h2>Беременность / лактация</h2><p>Любые добавки и процедуры — только после консультации с врачом.</p></div>`);
  }
  if (answers.allergy === 'yes') {
    parts.push(`<div class="card flag-warn"><h2>Аллергия на сырьё</h2><p>Уточните источник коллагена: рыба, КРС, свинина. Подбирайте вместе с врачом или фармацевтом.</p></div>`);
  } else if (answers.allergy === 'unknown') {
    parts.push(`<div class="card flag-warn"><h2>Аллергия не известна</h2><p>Перед приёмом добавок уточните аллергологический анамнез.</p></div>`);
  }
  return parts.join('');
}

function renderComplaintCards(answers) {
  return (answers.complaints || []).map(key => {
    const d = COMPLAINT_DATA[key];
    if (!d) return '';
    const evClass = d.evidence === 'mid' ? 'mid' : (d.evidence === 'low' ? 'low' : '');
    return `
      <div class="card result-card">
        <h2>${escapeHtml(d.title)}</h2>
        <p>
          <span class="badge">Типы: ${escapeHtml(d.types)}</span>
          <span class="badge ${evClass}">Доказательность: ${escapeHtml(d.evidenceText)}</span>
        </p>
        <h3>Форма / путь</h3>
        <p>${escapeHtml(d.form)}</p>
        <h3>Что важно</h3>
        <ul>${d.points.map(p => `<li>${escapeHtml(p)}</li>`).join('')}</ul>
        <h3>Когда к врачу</h3>
        <p>${escapeHtml(d.doctor)}</p>
        ${renderSlidesLink(d.slides)}
        ${renderSources(d.sources)}
      </div>`;
  }).join('');
}

function renderPrintHeader() {
  const now = new Date();
  const dateStr = now.toLocaleString('ru-RU', { dateStyle: 'long', timeStyle: 'short' });
  return `
    <div class="print-header print-only">
      <h1>Коллаген-Навигатор — результат подбора</h1>
      <div class="meta">Дата: ${escapeHtml(dateStr)} · Учебный проект · Не является медицинским заключением</div>
    </div>`;
}

function renderResult(answers, opts = {}) {
  const parts = [];
  parts.push(renderPrintHeader());
  parts.push(`<div class="disclaimer no-print">⚠️  Это не диагностика. Результат носит информационный характер. При сомнениях обратитесь к врачу.</div>`);
  parts.push(renderFlags(answers));
  parts.push(renderComplaintCards(answers));

  if (!answers.complaints || answers.complaints.length === 0) {
23:57
parts.push(`<div class="card"><h2>Жалобы не выбраны</h2><p>Вы отметили только красные флаги. Сначала — консультация врача. После — можно вернуться к анкете.</p></div>`);
  }

  const presentationBtn = (SITE_CONFIG.presentationUrl && SITE_CONFIG.presentationUrl !== '#')
    ? `<a class="btn-ghost" href="${SITE_CONFIG.presentationUrl}" target="_blank" rel="noopener">📊  Открыть презентацию</a>`
    : '';

  parts.push(`
    <div class="btn-row no-print">
      <button type="button" class="btn-ghost" onclick="backToForm()">← Пройти заново</button>
      <button type="button" class="btn-primary" onclick="window.print()">🖨 Сохранить для врача</button>
      ${presentationBtn}
    </div>`);

  resultView.innerHTML = parts.join('');
  formView.classList.add('hidden');
  reference.classList.remove('hidden');
  resultView.classList.remove('hidden');
  if (!opts.fromRestore) window.scrollTo({ top: 0, behavior: 'smooth' });
}

window.backToForm = function () {
  resultView.classList.add('hidden');
  reference.classList.add('hidden');
  formView.classList.remove('hidden');
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

window.scrollToFormOrTop = function () {
  const formVisible = !formView.classList.contains('hidden');
  const target = formVisible ? $('#quiz') : (resultView.classList.contains('hidden') ? $('main') : resultView);
  if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
};

/* ============================================================
   Список литературы
   ============================================================ */
function renderReferencesList() {
  const list = $('#references-list');
  if (!list) return;
  const items = Object.values(REFERENCES).map(r => `
    <li>${escapeHtml(r.full)} — <a href="${r.url}" target="_blank" rel="noopener">открыть</a></li>
  `).join('');
  list.innerHTML = items;
}

/* ============================================================
   Отзывы
   ============================================================ */
function loadReviews() {
  try { return JSON.parse(localStorage.getItem(STORAGE_KEYS.reviews) || '[]'); }
  catch (e) { return []; }
}

function saveReviews(list) {
  try { localStorage.setItem(STORAGE_KEYS.reviews, JSON.stringify(list)); }
  catch (e) {}
}

function stars(n) {
  return '★'.repeat(Number(n)) + '☆'.repeat(5 - Number(n));
}

function renderReviews() {
  const box = $('#review-list');
  if (!box) return;
  const list = loadReviews();
  if (!list.length) {
    box.innerHTML = '<p class="muted">Пока отзывов нет. Будьте первым.</p>';
    return;
  }
  box.innerHTML = list.slice().reverse().map(r => `
    <div class="review-item">
      <div class="meta">${escapeHtml(r.name || 'Аноним')} · ${r.role === 'doctor' ? 'врач' : 'пользователь'} · ${escapeHtml(new Date(r.date).toLocaleDateString('ru-RU'))}</div>
      <div class="stars">${stars(r.rating)}</div>
      <p>${escapeHtml(r.comment || '')}</p>
    </div>
  `).join('');
}

async function submitReview(data) {
  // 1) Всегда сохраняем локально
  const list = loadReviews();
  list.push(data);
  saveReviews(list);
  renderReviews();

  // 2) Если есть endpoint — отправляем на сервер
  if (SITE_CONFIG.feedbackEndpoint) {
    try {
      await fetch(SITE_CONFIG.feedbackEndpoint, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data)
      });
      return { ok: true, channel: 'server' };
    } catch (e) {
      return { ok: false, channel: 'server', error: e };
    }
  }

  // 3) Иначе — fallback на mailto
  const body = encodeURIComponent(
    `Имя: ${data.name || 'Аноним'}\nРоль: ${data.role}\nОценка: ${data.rating}\n\n${data.comment || ''}`
  );
  const subject = encodeURIComponent('Отзыв — Коллаген-Навигатор');
  if (SITE_CONFIG.feedbackEmail) {
    window.location.href = `mailto:${SITE_CONFIG.feedbackEmail}?subject=${subject}&body=${body}`;
  }
  return { ok: true, channel: 'mailto' };
}
23:57
function setupReviewForm() {
  const f = $('#review-form');
  if (!f) return;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = $('#review-status');
    const name = $('#rev-name').value.trim();
    const role = $('#rev-role').value;
    const rating = $('#rev-rating').value;
    const comment = $('#rev-comment').value.trim();
    if (!comment && !name) {
      status.textContent = 'Добавьте хотя бы имя или комментарий.';
      return;
    }
    status.textContent = 'Отправляем…';
    const res = await submitReview({
      name, role, rating, comment,
      date: new Date().toISOString()
    });
    if (res.ok) {
      status.textContent = res.channel === 'mailto'
        ? 'Отзыв сохранён локально. Открываем почтовый клиент для отправки автору…'
        : 'Спасибо! Отзыв сохранён.';
      f.reset();
    } else {
      status.textContent = 'Не удалось отправить. Отзыв сохранён локально.';
    }
  });
}

/* ============================================================
   Аналитика (опционально)
   ============================================================ */
function setupAnalytics() {
  if (SITE_CONFIG.analytics === 'plausible' && SITE_CONFIG.analyticsPlausibleDomain) {
    const s = document.createElement('script');
    s.defer = true;
    s.dataset.domain = SITE_CONFIG.analyticsPlausibleDomain;
    s.src = 'https://plausible.io/js/script.js';
    document.head.appendChild(s);
  }
  if (SITE_CONFIG.analytics === 'yandex' && SITE_CONFIG.analyticsYandexId) {
    (function (m, e, t, r, i, k, a) {
      m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
      m[i].l = 1 * new Date();
      k = e.createElement(t); a = e.getElementsByTagName(t)[0];
      k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
    })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
    window.ym(SITE_CONFIG.analyticsYandexId, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true });
  }
}

function track(event, params) {
  try {
    if (window.plausible) window.plausible(event, { props: params });
    if (window.ym && SITE_CONFIG.analyticsYandexId) window.ym(SITE_CONFIG.analyticsYandexId, 'reachGoal', event, params);
  } catch (e) {}
}

/* ============================================================
   PWA
   ============================================================ */
function setupPWA() {
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('sw.js').catch(() => {});
    });
  }
}

/* ============================================================
   Инициализация
   ============================================================ */
document.addEventListener('DOMContentLoaded', () => {
  setupPresentationLinks();
  setupAnalytics();
  setupPWA();
  renderReferencesList();
  setupReviewForm();
  renderReviews();
  restoreAnswers();
  restoreResultIfAny();

  const mail = $('#contact-mail');
  if (mail && SITE_CONFIG.feedbackEmail) {
    mail.href = 'mailto:' + SITE_CONFIG.feedbackEmail;
    mail.textContent = SITE_CONFIG.feedbackEmail;
  }

  form.addEventListener('change', () => { updateProgress(); saveAnswers(); });

  $('#reset-btn').addEventListener('click', () => {
    form.reset();
    updateProgress();
    try {
      localStorage.removeItem(STORAGE_KEYS.answers);
      localStorage.removeItem(STORAGE_KEYS.result);
    } catch (e) {}
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!getRadio('age')) { alert('Укажите возрастную группу.'); return; }
    const answers = collectAnswers();
    if (answers.complaints.length === 0 && answers.flags.length === 0) {
      alert('Выберите хотя бы одну жалобу или красный флаг.');
      return;
    }
    saveResult(answers);
    track('result_shown', { complaints: answers.complaints.join(','), flags: answers.flags.length });
    renderResult(answers);
  });
});
</script>
