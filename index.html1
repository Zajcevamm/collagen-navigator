<style>
  :root {
    --bg: #f7f9fc;
    --card: #ffffff;
    --text: #1f2a37;
    --muted: #6b7280;
    --primary: #2f6feb;
    --primary-dark: #1e50c4;
    --danger: #d94343;
    --danger-bg: #fdecec;
    --warn: #b7791f;
    --warn-bg: #fff8e6;
    --ok: #2f855a;
    --ok-bg: #e9f7ef;
    --border: #e5e9f0;
    --radius: 14px;
    --shadow: 0 1px 3px rgba(15,30,60,0.04);
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.55;
    padding-bottom: env(safe-area-inset-bottom);
  }
  a { color: var(--primary); }
  a:focus-visible, button:focus-visible, .option:focus-within {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* Шапка */
  header.top {
    background: linear-gradient(135deg, #2f6feb, #1e50c4);
    color: #fff;
    padding: 32px 20px 28px;
    padding-top: calc(32px + env(safe-area-inset-top));
    text-align: center;
  }
  header.top h1 { margin: 0 0 6px; font-size: 1.9rem; }
  header.top p { margin: 0 0 14px; opacity: 0.92; }
  .top-actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .top-actions a {
    color: #fff; text-decoration: none; border: 1px solid rgba(255,255,255,0.5);
    padding: 8px 14px; border-radius: 99px; font-size: 0.9rem;
    min-height: 44px; display: inline-flex; align-items: center;
  }
  .top-actions a:hover { background: rgba(255,255,255,0.15); }

  main { max-width: 780px; margin: 0 auto; padding: 20px 16px 60px; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
    margin-bottom: 14px;
    box-shadow: var(--shadow);
  }
  .card h2 { margin: 0 0 12px; font-size: 1.15rem; }
  .card h3 { margin: 16px 0 6px; font-size: 1rem; }
  .muted { color: var(--muted); font-size: 0.92rem; }

  /* Кнопки — минимум 44px для пальца */
  button, .btn {
    font: inherit; cursor: pointer; border: none; border-radius: 10px;
    padding: 12px 20px; font-weight: 600; min-height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background 0.15s ease, transform 0.05s ease;
  }
  .btn-primary { background: var(--primary); color: #fff; }
  .btn-primary:hover { background: var(--primary-dark); }
  .btn-primary:active { transform: translateY(1px); }
  .btn-ghost { background: transparent; color: var(--primary); border: 1px solid var(--border); }
  .btn-ghost:hover { background: #f0f4ff; }
  .btn-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }

  /* Формы */
  fieldset { border: none; padding: 0; margin: 0 0 16px; }
  fieldset > legend { display: block; font-weight: 600; margin-bottom: 8px; font-size: 0.98rem; }
  .option {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 12px 14px; border: 1px solid var(--border);
    border-radius: 10px; margin-bottom: 8px; cursor: pointer;
    min-height: 44px;
23:57
transition: background 0.12s ease, border-color 0.12s ease;
  }
  .option:hover { background: #f7f9ff; }
  .option input { margin-top: 3px; flex-shrink: 0; width: 18px; height: 18px; }
  .option:has(input:checked) { border-color: var(--primary); background: #eef4ff; }

  .progress { height: 8px; background: var(--border); border-radius: 99px; overflow: hidden; margin-bottom: 18px; }
  .progress > div { height: 100%; background: var(--primary); width: 0; transition: width 0.25s ease; }

  /* Плашки */
  .flag-danger { background: var(--danger-bg); border: 1px solid #f5c2c2; border-left: 4px solid var(--danger); }
  .flag-danger h2 { color: var(--danger); }
  .flag-warn { background: var(--warn-bg); border-left: 4px solid var(--warn); }
  .flag-ok { background: var(--ok-bg); border-left: 4px solid var(--ok); }
  .disclaimer {
    background: #fff8e6; border: 1px solid #f2e1b3; border-radius: var(--radius);
    padding: 12px 16px; font-size: 0.92rem; color: #6b5516; margin-bottom: 14px;
  }

  .badge {
    display: inline-block; font-size: 0.78rem; padding: 3px 10px;
    border-radius: 99px; background: #eef4ff; color: var(--primary);
    font-weight: 600; margin-right: 6px; margin-bottom: 4px;
  }
  .badge.mid { background: #fff3d6; color: #8a6d1f; }
  .badge.low { background: #f2f2f2; color: #666; }
  .result-card { border-left: 4px solid var(--primary); }

  /* Источники и слайды */
  .sources {
    font-size: 0.88rem; color: var(--muted); margin-top: 12px;
    padding-top: 10px; border-top: 1px dashed var(--border);
  }
  .sources a { color: var(--primary); text-decoration: none; }
  .sources a:hover { text-decoration: underline; }
  .slides-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.9rem; margin-top: 8px;
  }

  details { margin: 6px 0; }
  details summary { cursor: pointer; font-weight: 600; padding: 10px 0; min-height: 44px; display: flex; align-items: center; }
  details p { margin: 6px 0; }

  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { background: #f7f9fc; font-weight: 600; }

  /* Липкая панель на мобильном */
  .sticky-cta {
    position: sticky; bottom: 0; z-index: 10;
    padding: 10px 16px; padding-bottom: calc(10px + env(safe-area-inset-bottom));
    background: rgba(247,249,252,0.95);
    backdrop-filter: blur(6px);
    border-top: 1px solid var(--border);
    display: none;
  }
  .sticky-cta button { width: 100%; }
  @media (max-width: 720px) {
    .sticky-cta { display: block; }
    header.top h1 { font-size: 1.45rem; }
    .card { padding: 14px; }
    main { padding: 14px 12px 80px; }
    .btn-row button, .btn-row a { flex: 1 1 100%; }
  }

  /* Отзывы */
  .review-form input, .review-form textarea, .review-form select {
    width: 100%; font: inherit; padding: 12px;
    border: 1px solid var(--border); border-radius: 10px;
    background: #fff; color: var(--text);
    min-height: 44px;
  }
  .review-form textarea { min-height: 96px; resize: vertical; }
  .review-form label { display: block; margin: 10px 0 4px; font-weight: 600; font-size: 0.92rem; }
  .review-list { margin-top: 12px; }
  .review-item {
    border: 1px solid var(--border); border-radius: 10px;
    padding: 10px 12px; margin-bottom: 8px; background: #fbfcfe;
  }
  .review-item .meta { font-size: 0.8rem; color: var(--muted); margin-bottom: 4px; }
  .stars { color: #f2b53a; font-size: 1rem; }

  .hidden { display: none !important; }
  footer.site-footer {
    text-align: center; color: var(--muted);
    font-size: 0.85rem; padding: 20px 16px;
    padding-bottom: calc(20px + env(safe-area-inset-bottom));
  }

  /* Печать */
  .print-only { display: none; }
  @media print {
    header.top, .top-actions, .btn-row, .sticky-cta, .disclaimer, footer.site-footer,
    #form-view, details, .review-form, .no-print { display: none !important; }
